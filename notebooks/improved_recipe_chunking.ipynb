   "source": [
    "# Улучшенное создание векторного хранилища с оптимизированным чанкованием\n",
    "\n",
    "Этот notebook создает улучшенную версию векторного хранилища с:\n",
    "- Рецепт-ориентированным чанкованием\n",
    "- Богатыми метаданными\n",
    "- Оптимизированным FAISS индексом (IndexIVFFlat)\n",
    "- Поддержкой Markdown версии книги"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Отключение параллелизма для избежания конфликтов\n",
    "import os\n",
    "os.environ[\"TOKENIZERS_PARALLELISM\"] = \"false\"\n",
    "\n",
    "# Установка необходимых пакетов\n",
    "# !pip install langchain langchain-community langchain_huggingface unstructured pypandoc -q\n",
    "# !pip install faiss-cpu -q\n",
    "# !pip install cohere -q"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Импорт библиотек\n",
    "from langchain.document_loaders import UnstructuredMarkdownLoader\n",
    "from langchain_core.documents import Document\n",
    "from langchain.prompts import PromptTemplate\n",
    "from langchain.chains import RetrievalQA\n",
    "from langchain_huggingface import HuggingFaceEmbeddings\n",
    "from langchain_community.vectorstores import FAISS\n",
    "from langchain.text_splitter import TextSplitter\n",
    "from typing import List, Dict, Any\n",
    "import re\n",
    "import json\n",
    "from pathlib import Path\n",
    "import numpy as np\n",
    "from dotenv import load_dotenv\n",
    "\n",
    "load_dotenv()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Функция для чтения токена из .env\n",
    "def read_token(file_path='../.env'):\n",
    "    \"\"\"Читает токен HuggingFace из файла .env\"\"\"\n",
    "    with open(file_path, 'r') as f:\n",
    "        for line in f:\n",
    "            if line.startswith(\"HUGGINGFACEHUB_API_TOKEN\"):\n",
    "                return line.split('=')[1].strip()\n",
    "    raise ValueError(\"Token not found in the specified file.\")\n",
    "\n",
    "# Загрузка токена\n",
    "hf_token = os.getenv('HUGGINGFACEHUB_API_TOKEN') or read_token()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Инициализация модели эмбеддингов (те же параметры что в оригинале)\n",
    "hf_embeddings_model = HuggingFaceEmbeddings(\n",
    "    model_name=\"cointegrated/LaBSE-en-ru\",\n",
    "    model_kwargs={\"device\": \"cpu\", \"token\": hf_token},\n",
    "    encode_kwargs={\n",
    "        'normalize_embeddings': True  # Для косинусной схожести\n",
    "    }\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class ImprovedRecipeSplitter(TextSplitter):\n",
    "    \"\"\"\n",
    "    Улучшенный сплиттер для рецепт-ориентированного чанкования\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self):\n",
    "        super().__init__(chunk_size=2000, chunk_overlap=200)\n",
    "    \n",
    "    def extract_ingredients(self, text: str) -> List[str]:\n",
    "        \"\"\"Извлекает список ингредиентов из текста рецепта\"\"\"\n",
    "        ingredients = []\n",
    "        \n",
    "        # Поиск строк с объемами и весами\n",
    "        ingredient_patterns = [\n",
    "            r'(\\d+\\s*мл\\s+[^;]+)',\n",
    "            r'(\\d+\\s*г\\s+[^;]+)', \n",
    "            r'(\\d+\\s*столов[а-я]*\\s*ложк[а-я]*\\s+[^;]+)',\n",
    "            r'(\\d+\\s*чайн[а-я]*\\s*ложк[а-я]*\\s+[^;]+)',\n",
    "            r'(\\d+\\s*[^0-9]+(?:водк|виск|джин|ром|текил|ликер|сок|сироп|лимон|апельсин|грейпфрут)[^;.]*)',\n",
    "        ]\n",
    "        \n",
    "        for pattern in ingredient_patterns:\n",
    "            matches = re.findall(pattern, text, re.IGNORECASE)\n",
    "            ingredients.extend(matches)\n",
    "        \n",
    "        # Очистка и нормализация\n",
    "        cleaned_ingredients = []\n",
    "        for ingredient in ingredients:\n",
    "            clean_ing = re.sub(r'[^\\w\\s]', '', ingredient.lower().strip())\n",
    "            if len(clean_ing) > 3:\n",
    "                cleaned_ingredients.append(clean_ing)\n",
    "        \n",
    "        return list(set(cleaned_ingredients))\n",
    "    \n",
    "    def extract_recipe_name(self, text: str) -> str:\n",
    "        \"\"\"Извлекает название рецепта\"\"\"\n",
    "        lines = text.split('\\n')\n",
    "        for i, line in enumerate(lines[:5]):\n",
    "            line = line.strip()\n",
    "            if line and not line.startswith('*') and len(line) < 100:\n",
    "                if not any(word in line.lower() for word in ['роман', 'книга', 'автор', 'писатель']):\n",
    "                    return line\n",
    "        return \"Неизвестный рецепт\"\n",
    "    \n",
    "    def clean_text(self, text: str) -> str:\n",
    "        \"\"\"Очищает текст от разметки\"\"\"\n",
    "        # Убираем Markdown разметку\n",
    "        text = re.sub(r'\\*\\*([^*]+)\\*\\*', r'\\1', text)\n",
    "        text = re.sub(r'\\*([^*]+)\\*', r'\\1', text)\n",
    "        text = re.sub(r'`([^`]+)`', r'\\1', text)\n",
    "        text = re.sub(r'\\[([^\\]]+)\\]\\([^)]+\\)', r'\\1', text)\n",
    "        text = re.sub(r'\\n\\s*\\n', '\\n\\n', text)\n",
    "        text = re.sub(r' +', ' ', text)\n",
    "        return text.strip()\n",
    "    \n",
    "    def split_text(self, text: str) -> List[str]:\n",
    "        \"\"\"Разбивает текст на рецепт-ориентированные чанки\"\"\"\n",
    "        cleaned_text = self.clean_text(text)\n",
    "        chunks = []\n",
    "        current_chunk = []\n",
    "        \n",
    "        lines = cleaned_text.split('\\n')\n",
    "        i = 0\n",
    "        \n",
    "        while i < len(lines):\n",
    "            line = lines[i].strip()\n",
    "            \n",
    "            # Определяем начало нового рецепта\n",
    "            is_new_recipe = (\n",
    "                i + 1 < len(lines) and \n",
    "                line and \n",
    "                len(line) < 100 and\n",
    "                lines[i+1].strip().isupper() and\n",
    "                '(' in lines[i+1] and ')' in lines[i+1]\n",
    "            )\n",
    "            \n",
    "            if is_new_recipe and current_chunk:\n",
    "                chunk_text = '\\n'.join(current_chunk)\n",
    "                if len(chunk_text.strip()) > 100:\n",
    "                    chunks.append(chunk_text)\n",
    "                current_chunk = []\n",
    "            \n",
    "            current_chunk.append(line)\n",
    "            i += 1\n",
    "        \n",
    "        # Добавляем последний чанк\n",
    "        if current_chunk:\n",
    "            chunk_text = '\\n'.join(current_chunk)\n",
    "            if len(chunk_text.strip()) > 100:\n",
    "                chunks.append(chunk_text)\n",
    "        \n",
    "        return chunks\n",
    "    \n",
    "    def create_documents_with_metadata(self, texts: List[str]) -> List[Document]:\n",
    "        \"\"\"Создает документы с богатыми метаданными\"\"\"\n",
    "        documents = []\n",
    "        \n",
    "        for i, text in enumerate(texts):\n",
    "            recipe_name = self.extract_recipe_name(text)\n",
    "            ingredients = self.extract_ingredients(text)\n",
    "            \n",
    "            # Определяем тип напитка\n",
    "            drink_type = \"коктейль\"\n",
    "            if any(word in text.lower() for word in ['пунш', 'глинтвейн', 'грог']):\n",
    "                drink_type = \"горячий напиток\"\n",
    "            elif any(word in text.lower() for word in ['настойка', 'ликер']):\n",
    "                drink_type = \"настойка\"\n",
    "            elif any(word in text.lower() for word in ['безалкогольный', 'сок', 'лимонад']):\n",
    "                drink_type = \"безалкогольный\"\n",
    "            \n",
    "            doc = Document(\n",
    "                page_content=text,\n",
    "                metadata={\n",
    "                    'recipe_name': recipe_name,\n",
    "                    'ingredients': ingredients,\n",
    "                    'ingredients_str': ', '.join(ingredients),\n",
    "                    'drink_type': drink_type,\n",
    "                    'chunk_id': i,\n",
    "                    'char_count': len(text)\n",
    "                }\n",
    "            )\n",
    "            documents.append(doc)\n",
    "        \n",
    "        return documents"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Загружаем markdown файл\n",
    "try:\n",
    "    loader = UnstructuredMarkdownLoader('../docs/Federle_pandoc.md')\n",
    "    doc_markdown = loader.load()\n",
    "    \n",
    "    # Объединяем все элементы в один текст\n",
    "    full_text = \"\\n\".join([doc.page_content for doc in doc_markdown])\n",
    "    \n",
    "    print(f'Общий размер текста: {len(full_text)} символов')\n",
    "    \n",
    "except Exception as e:\n",
    "    print(f'Ошибка загрузки файла: {e}')\n",
    "    # Можно загрузить из URL если файла нет локально\n",
    "    import requests\n",
    "    url = 'https://raw.githubusercontent.com/trofimovelijah/cocktail_qr/main/docs/Federle_pandoc.md'\n",
    "    response = requests.get(url)\n",
    "    full_text = response.text\n",
    "    print(f'Загружен текст из URL: {len(full_text)} символов')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Применяем улучшенный сплиттер\n",
    "improved_splitter = ImprovedRecipeSplitter()\n",
    "\n",
    "# Разбиваем текст на чанки\n",
    "chunks_text = improved_splitter.split_text(full_text)\n",
    "print(f'Количество текстовых чанков: {len(chunks_text)}')\n",
    "\n",
    "# Создаем документы с метаданными\n",
    "chunks_with_metadata = improved_splitter.create_documents_with_metadata(chunks_text)\n",
    "\n",
    "print(f'Количество документов с метаданными: {len(chunks_with_metadata)}')\n",
    "print(f'Максимальное количество символов в чанке: {max([len(chunk.page_content) for chunk in chunks_with_metadata])}')\n",
    "\n",
    "# Пример метаданных\n",
    "if chunks_with_metadata:\n",
    "    print(\"\\nПример метаданных первого чанка:\")\n",
    "    print(f\"Название рецепта: {chunks_with_metadata[0].metadata['recipe_name']}\")\n",
    "    print(f\"Ингредиенты: {chunks_with_metadata[0].metadata['ingredients'][:3]}...\")\n",
    "    print(f\"Тип напитка: {chunks_with_metadata[0].metadata['drink_type']}\")"
   ]
  },
  {
   "cell_type": "code",
