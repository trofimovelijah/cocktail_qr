   "source": [
    "def create_optimized_faiss_index(documents: List[Document], embeddings_model):\n",
    "    \"\"\"\n",
    "    Создает оптимизированный FAISS индекс с IndexIVFFlat\n",
    "    \"\"\"\n",
    "    \n",
    "    print(\"Создаем эмбеддинги для документов...\")\n",
    "    \n",
    "    # Создаем простой индекс для получения эмбеддингов\n",
    "    simple_db = FAISS.from_documents(documents, embeddings_model)\n",
    "    \n",
    "    # Получаем векторы и метаданные\n",
    "    vectors = simple_db.index.reconstruct_n(0, simple_db.index.ntotal)\n",
    "    docstore = simple_db.docstore\n",
    "    index_to_docstore_id = simple_db.index_to_docstore_id\n",
    "    \n",
    "    print(f\"Создан простой индекс с {len(vectors)} векторами размерности {vectors.shape[1]}\")\n",
    "    \n",
    "    # Создаем оптимизированный IndexIVFFlat\n",
    "    import faiss\n",
    "    \n",
    "    dimension = vectors.shape[1]\n",
    "    n_clusters = min(100, len(vectors) // 4)\n",
    "    \n",
    "    # Создаем квантайзер и IndexIVFFlat\n",
    "    quantizer = faiss.IndexFlatL2(dimension)\n",
    "    optimized_index = faiss.IndexIVFFlat(quantizer, dimension, n_clusters)\n",
    "    \n",
    "    # Обучаем индекс\n",
    "    print(f\"Обучаем IndexIVFFlat с {n_clusters} кластерами...\")\n",
    "    optimized_index.train(vectors.astype('float32'))\n",
    "    \n",
    "    # Добавляем векторы\n",
    "    optimized_index.add(vectors.astype('float32'))\n",
    "    \n",
    "    # Устанавливаем nprobe\n",
    "    optimized_index.nprobe = min(10, n_clusters // 2)\n",
    "    print(f\"Установлен nprobe = {optimized_index.nprobe}\")\n",
    "    \n",
    "    # Создаем новый FAISS объект\n",
    "    optimized_db = FAISS(\n",
    "        embedding_function=embeddings_model,\n",
    "        index=optimized_index,\n",
    "        docstore=docstore,\n",
    "        index_to_docstore_id=index_to_docstore_id\n",
    "    )\n",
    "    \n",
    "    return optimized_db"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Создаем оптимизированный индекс\n",
    "try:\n",
    "    print(\"Создаем оптимизированный FAISS индекс...\")\n",
    "    db_optimized = create_optimized_faiss_index(chunks_with_metadata, hf_embeddings_model)\n",
    "    print(\"✓ Оптимизированный индекс успешно создан\")\n",
    "except Exception as e:\n",
    "    print(f\"Ошибка при создании оптимизированного индекса: {e}\")\n",
    "    print(\"Создаем стандартный индекс как fallback...\")\n",
    "    db_optimized = FAISS.from_documents(chunks_with_metadata, hf_embeddings_model)"
   ]
  },
