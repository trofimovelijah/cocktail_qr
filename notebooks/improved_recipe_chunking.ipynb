    "# Тестируем поиск\n",
    "test_db = FAISS.load_local(\n",
    "    save_path, \n",
    "    hf_embeddings_model, \n",
    "    allow_dangerous_deserialization=True\n",
    ")\n",
    "\n",
    "test_queries = [\n",
    "    \"грейпфрутовый сок ржаной виски\",\n",
    "    \"ржаной виски грейпфрут\", \n",
    "    \"рожь предубеждение\",\n",
    "    \"grapefruit rye whiskey\"\n",
    "]\n",
    "\n",
    "print(\"=== ТЕСТИРОВАНИЕ ПОИСКА ===")\n",
    "for query in test_queries:\n",
    "    print(f\"\\nЗапрос: '{query}'\")\n",
    "    results = test_db.similarity_search(query, k=3)\n",
    "    \n",
    "    for i, result in enumerate(results, 1):\n",
    "        recipe_name = result.metadata.get('recipe_name', 'Неизвестно')\n",
    "        ingredients = result.metadata.get('ingredients_str', '')\n",
    "        print(f\"  {i}. {recipe_name}\")\n",
    "        print(f\"     Ингредиенты: {ingredients[:100]}...\")\n",
    "        if 'рож' in recipe_name.lower() and ('предуб' in recipe_name.lower() or 'гордост' in recipe_name.lower()):\n",
    "            print(\"     ✓ НАЙДЕН ЦЕЛЕВОЙ РЕЦЕПТ!\")"
   ]
