   "source": [
    "# Сохраняем векторную базу\n",
    "data_dir = Path(\"../data\")\n",
    "data_dir.mkdir(exist_ok=True)\n",
    "\n",
    "save_path = \"../data/faiss_db_improved_markdown\"\n",
    "db_optimized.save_local(save_path)\n",
    "\n",
    "print(f\"✓ Векторная база сохранена в: {save_path}\")\n",
    "\n",
    "# Сохраняем метаданные\n",
    "metadata_file = data_dir / \"recipe_metadata.json\"\n",
    "all_metadata = [doc.metadata for doc in chunks_with_metadata]\n",
    "\n",
    "with open(metadata_file, 'w', encoding='utf-8') as f:\n",
    "    json.dump(all_metadata, f, ensure_ascii=False, indent=2)\n",
    "\n",
    "print(f\"✓ Метаданные сохранены в: {metadata_file}\")"
   ]
